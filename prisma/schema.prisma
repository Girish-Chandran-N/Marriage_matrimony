generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  VERIFIER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationAction {
  VIEWED
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  role          Role      @default(USER)
  status        AccountStatus @default(ACTIVE)
  profileImage  String?   // Main profile image
  galleryImages String[]  // Additional profile images
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  phoneNumber   String?   @unique

  // Online Presence
  lastSeen      DateTime?
  isOnline      Boolean   @default(false)

  // Profile Sections
  personalDetails   PersonalDetails?
  familyDetails     FamilyDetails?
  careerProfile     CareerProfile?
  lifestyleDetails  LifestyleDetails?
  
  // Lists
  educations        Education[]
  jobs              Job[]
  siblings          Sibling[]
  photos            UserPhoto[]
  
  // Existing Relations
  verificationRequests VerificationRequest[]
  matchPreferences     MatchPreferences?

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  
  conversations    Conversation[] @relation("UserConversations")
  
  // Admin Relations
  banLogs          BanLog[]  @relation("BannedUser")
  issuedBans       BanLog[]  @relation("AdminUser")
  verificationLogs VerificationLog[] @relation("AdminVerifier")
  
  // Advanced Admin Relations
  activityLogs     ActivityLog[]
  filedReports     Report[]      @relation("Reporter")
  receivedReports  Report[]      @relation("Reported")
  
  // Blocking Relations
  sentBlocks     Block[] @relation("BlockingUsers")
  receivedBlocks Block[] @relation("BlockedUsers")

  // Payment & Subscription
  subscription   Subscription?

  // Interactions
  sentInterests     Interest[] @relation("SentInterests")
  receivedInterests Interest[] @relation("ReceivedInterests")
  
  profileViews      ProfileView[] @relation("ProfileViewer")
  profileViewedBy   ProfileView[] @relation("ProfileViewed")
  
  shortlisted       Shortlist[] @relation("UserShortlists")
  shortlistedBy     Shortlist[] @relation("ShortlistedUsers")
  
  contactViews      ContactView[] @relation("ContactViewer")
  contactViewedBy   ContactView[] @relation("ContactViewed")
}

enum MembershipTier {
  FREE
  STARTER
  BASIC
  SILVER
  GOLD
  PLATINUM
  ELITE
}

model Subscription {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  plan            MembershipTier @default(FREE)
  startDate       DateTime       @default(now())
  endDate         DateTime
  razorpayOrderId String?
  razorpayPaymentId String?
  status          String         @default("active") // active, expired, cancelled
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model BanLog {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("BannedUser", fields: [userId], references: [id])
  adminId     String
  admin       User      @relation("AdminUser", fields: [adminId], references: [id])
  reason      String
  notes       String?
  status      AccountStatus // The status applied (SUSPENDED or BANNED)
  createdAt   DateTime  @default(now())
}

model VerificationRequest {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  careerProfileId String
  careerProfile   CareerProfile @relation(fields: [careerProfileId], references: [id])
  status          RequestStatus @default(PENDING)
  documentUrls    String[]
  adminNotes      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  logs            VerificationLog[]
}

model VerificationLog {
  id        String             @id @default(cuid())
  requestId String
  request   VerificationRequest @relation(fields: [requestId], references: [id])
  adminId   String
  admin     User               @relation("AdminVerifier", fields: [adminId], references: [id])
  action    VerificationAction
  notes     String?
  createdAt DateTime           @default(now())
}

model PersonalDetails {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Basic
  dateOfBirth   DateTime?
  gender        String?
  height        Float?   
  weight        Float?   
  bloodGroup    String?
  bodyType      String?  
  complexion    String?  
  maritalStatus String?  
  physicalStatus String?
  motherTongue   String?
  knownLanguages String[]
  
  // Bio
  bio           String?  @db.Text
  about         String?  @db.Text
  
  // Religion
  religion      String?
  caste         String?
  subCaste      String?

  // Native Location
  nativeCountry String?
  nativeState   String?
  nativeDistrict String?
  nativeCity    String?
  nationality   String?

  // Residing Location
  residingCountry String?
  residingState   String?
  residingDistrict String?
  residingCity    String? // Town/Place
  
  // existing keys for backward compatibility or simple location?
  // city          String? 
  // district      String?
  // state         String?
  // country       String?

  // Outstation
  leaveDateFrom DateTime?
  leaveDateTo   DateTime?

  // Contact
  primaryContact String?
  whatsapp       Boolean @default(false)
  custodianName  String?
  custodianRelation String?
  preferredTime  String?
  communicationAddress String?
  email          String? // Auto fetched from registration usually, but if different?
  
  // Reference
  referenceName     String?
  referenceRelation String?
  referenceContact  String?

  // ID Proof
  idProof       String?
  
  updatedAt     DateTime @updatedAt
}

model Education {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  qualification   String? // Highest/This Degree
  institution     String?
  university      String?
  stream          String?
  passedYear      Int? // Year
  
  isHighest       Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Job {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title           String?
  company         String?
  occupationCategory String?
  employmentCategory String?
  workType        String? // Full-time, etc
  
  country         String?
  state           String?
  district        String?
  city            String?
  
  fromMonth       Int?
  fromYear        Int?
  toMonth         Int?
  toYear          Int?
  isCurrent       Boolean @default(false)
  
  annualIncome    String?
  description     String? @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CareerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  currentStatus   String? // Working, Not Working, Student, Internship
  
  // Internship details
  internshipRole  String?
  internshipCompany String?
  internshipDuration String?
  careerGoal      String?
  
  linkedinUrl     String?
  
  country         String?
  visaStatus      String?
  willingToRelocate Boolean @default(false)
  
  // Backward compatibility fields (can be removed later or mapped to latest Job)
  jobTitle        String?
  companyName     String?
  employmentType  String? 
  incomeRange     String? 
  workLocation    String? 
  industry        String?
  yearsExperience Int?
  
  isVerified      Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  
  verificationRequests VerificationRequest[]
}

model FamilyDetails {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  familyStatus     String?  
  familyType       String?  
  familyValue      String?
  familyName       String?
  
  fatherName       String?
  fatherOccupation String?
  fatherNativePlace String?
  fatherHouseName  String?
  
  motherName       String?
  motherOccupation String?
  motherNativePlace String?
  motherHouseName  String?
  
  grandParentsDetails String? @db.Text
  familyIntro         String? @db.Text
  
  siblingsCount    Int?
  brothers         Int? // Count
  sisters          Int? // Count
  
  familyImages     String[] // Deprecated in favor of UserPhoto?
  
  updatedAt        DateTime @updatedAt
}

model Sibling {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  gender          String // Brother, Sister
  name            String?
  maritalStatus   String?
  spouseName      String?
}

model UserPhoto {
  id        String   @id @default(cuid())
  userId    String   
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  url       String
  isProfile Boolean @default(false) // If true, it is the main profile pic
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model LifestyleDetails {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  hobbies       String[]
  music         String[]
  books         String[]
  movies        String[]
  sports        String[]
  
  eatingHabits  String?
  drinking      String? 
  smoking       String?
  
  favoriteCuisine String[]
  dressStyle      String?
  culturalBackground String?
  adventureLevel  String? // Low, Medium, High
  petPreference   String?
  drivingLicense  Boolean?
  
  weekendPreference String?
  travelFrequency   String?
  learningInterest  String?
  
  // Social Media
  facebook      String?
  instagram     String?
  youtube       String?
  tiktok        String?
  blogger       String?
  linkedin      String? 
  otherSocial   String?
  
  // Backward compatibility
  diet          String? 
  
  updatedAt     DateTime @updatedAt
}



model MatchPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  
  // Basic
  minAge              Int?
  maxAge              Int?
  minHeight           Float?
  maxHeight           Float?
  maritalStatus       String[]
  physicalStatus      String?
  complexion          String[]
  bodyType            String[]
  familyStatus        String[]
  
  // Professional
  education           String[]
  jobStatus           String[]
  employmentCategory  String[]
  incomeRange         String[] // Array or String? User said "Income* (CB)" which implies checkboxes -> Array
  workingCountry      String[]
  readyToRelocate     Boolean?
  
  // Location
  preferredLocations  String[] // Country/State?
  
  // Religion
  preferredReligions  String[]
  preferredCastes     String[] // If needed
  preferredMotherTongues String[]
  otherReligions      Boolean @default(false)

  // Lifestyle
  eatingHabits        String[]
  drinkingHabits      String[]
  smokingHabits       String[]
  
  // Other
  expectations        String? @db.Text
  
  // Backward compatibility / Deprecated
  preferredIndustries String[]
  minExperience       Int?
  maxExperience       Int?
  minIncome           String? // Deprecated for incomeRange list
  maxIncome           String? // Deprecated

  updatedAt           DateTime @updatedAt
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  isLastMessageOf Conversation? @relation("LastMessage")
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants    User[]    @relation("UserConversations")
  messages        Message[]
  
  lastMessageId   String?   @unique
  lastMessage     Message?  @relation("LastMessage", fields: [lastMessageId], references: [id])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

    @@unique([email, token])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String? // Store simple JSON or text
  createdAt DateTime @default(now())
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reporter    User         @relation("Reporter", fields: [reporterId], references: [id])
  reportedId  String
  reported    User         @relation("Reported", fields: [reportedId], references: [id])
  reason      String
  status      ReportStatus @default(PENDING)
  adminNotes  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("BlockingUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Interest {
  id        String   @id @default(cuid())
  senderId  String
  sender    User     @relation("SentInterests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver  User     @relation("ReceivedInterests", fields: [receiverId], references: [id], onDelete: Cascade)
  status    InterestStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverId])
}

enum InterestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String
  viewer    User     @relation("ProfileViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  profileId String
  profile   User     @relation("ProfileViewed", fields: [profileId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())
}

model Shortlist {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("UserShortlists", fields: [userId], references: [id], onDelete: Cascade)
  shortlistedUserId String
  shortlistedUser   User     @relation("ShortlistedUsers", fields: [shortlistedUserId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([userId, shortlistedUserId])
}

model ContactView {
  id        String   @id @default(cuid())
  viewerId  String
  viewer    User     @relation("ContactViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  profileId String
  profile   User     @relation("ContactViewed", fields: [profileId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())


  @@unique([viewerId, profileId])
}

model Advertisement {
  id          String   @id @default(cuid())
  title       String?  // Internal reference name
  type        AdType   @default(MANUAL)
  placement   AdPlacementSlot @default(SIDEBAR)
  
  // Manual Ad Fields
  imageUrl    String?
  targetUrl   String?
  
  // Code Ad Fields
  adCode      String?  @db.Text // Google AdSense script/iframe code
  
  isActive    Boolean  @default(true)
  clickCount  Int      @default(0)
  viewCount   Int      @default(0)
  
  startDate   DateTime?
  endDate     DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AdType {
  MANUAL
  GOOGLE_ADS
}

enum AdPlacementSlot {
  SIDEBAR
  DASHBOARD
  FEED
  RIGHT_SIDEBAR
}
